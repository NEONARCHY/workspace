# LAN-only server on Bakhtiyor's PC. Never commit the filled .env.lan file.
# Keep the database and bucket names from the source backup when migrating data.
YUKSALISH_LAN_IP=192.168.1.10
POSTGRES_DB=yuksalish
POSTGRES_USER=yuksalish
POSTGRES_PASSWORD=replace-with-new-url-safe-32-character-password
MINIO_ROOT_USER=yuksalish
MINIO_ROOT_PASSWORD=replace-with-new-32-character-password
MINIO_BUCKET=workspace-files
YUKSALISH_ENVIRONMENT=production
YUKSALISH_DATABASE_URL=postgresql+asyncpg://yuksalish:replace-with-same-postgres-password@postgres:5432/yuksalish
YUKSALISH_AUTH_SIGNING_KEY=replace-with-new-random-32-character-signing-key
YUKSALISH_AUTH_ENCRYPTION_KEY=replace-with-new-random-32-character-encryption-key
YUKSALISH_PASSWORD_RESET_TTL_HOURS=2
YUKSALISH_SEED_DEMO_DATA=false
YUKSALISH_REDIS_URL=redis://redis:6379/0
YUKSALISH_S3_ENDPOINT=minio:9000
YUKSALISH_S3_ACCESS_KEY=yuksalish
YUKSALISH_S3_SECRET_KEY=replace-with-same-minio-root-password
YUKSALISH_S3_SECURE=false
YUKSALISH_S3_BUCKET=workspace-files
# Electron uses file:// ("null"); web uses the exact LAN HTTPS origin.
YUKSALISH_CORS_ORIGINS=["null","https://192.168.1.10:8443"]
# Shared secret (32+ random characters) used only by the Hisobot bot-to-API bridge.
YUKSALISH_HISOBOT_BRIDGE_TOKEN=
