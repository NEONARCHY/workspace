# Template only. Copy to .env.production and replace every replace-with value.
POSTGRES_DB=yuksalish
POSTGRES_USER=yuksalish
POSTGRES_PASSWORD=replace-with-production-database-password
MINIO_ROOT_USER=yuksalish_production
MINIO_ROOT_PASSWORD=replace-with-production-minio-root-password
MINIO_BUCKET=yuksalish-production-files
YUKSALISH_ENVIRONMENT=production
YUKSALISH_DATABASE_URL=postgresql+asyncpg://yuksalish:replace-with-url-safe-database-password@postgres:5432/yuksalish
YUKSALISH_AUTH_SIGNING_KEY=replace-with-random-production-auth-signing-key
YUKSALISH_AUTH_ENCRYPTION_KEY=replace-with-random-production-auth-encryption-key
YUKSALISH_PASSWORD_RESET_TTL_HOURS=2
YUKSALISH_SEED_DEMO_DATA=false
YUKSALISH_REDIS_URL=redis://redis:6379/0
YUKSALISH_S3_ENDPOINT=minio:9000
YUKSALISH_S3_ACCESS_KEY=yuksalish_production
YUKSALISH_S3_SECRET_KEY=replace-with-production-s3-secret-key
YUKSALISH_S3_SECURE=false
YUKSALISH_S3_BUCKET=yuksalish-production-files
YUKSALISH_CORS_ORIGINS=["https://app.example.invalid"]
CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace-with-reviewed-pinned-version
CLOUDFLARE_TUNNEL_TOKEN=replace-with-production-cloudflare-tunnel-token
