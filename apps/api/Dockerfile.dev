FROM python:3.11-slim

WORKDIR /workspace
COPY pyproject.toml README.md ./
# Install runtime requirements before mounting source, so edits do not rebuild dependencies.
RUN python -c "import subprocess, sys, tomllib; deps = tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']; subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir', *deps])" \
    && useradd --create-home --uid 10001 yuksalish \
    && mkdir -p /workspace/var/desktop-updates \
    && chown -R yuksalish:yuksalish /workspace/var

ENV PYTHONPATH=/workspace/apps/api/src:/workspace/modules/hisobot/importer/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER yuksalish
EXPOSE 8000
