{
  "name": "@yuksalish/desktop",
  "version": "1.0.13",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:web": "vite build --mode web",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "dev": "pnpm build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsup src/main/main.ts src/preload/preload.ts --format cjs --platform node --target node20 --out-dir dist-electron --sourcemap --clean --external electron",
    "lint": "eslint src vite.config.mts",
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "2.0.339",
    "@xyflow/react": "12.11.6",
    "@yuksalish/contracts": "workspace:*",
    "@yuksalish/i18n": "workspace:*",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "tabster": "8.8.0",
    "tsup": "8.5.1",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "uz.yuksalish.workspace",
    "productName": "Yuksalish Workspace",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Yuksalish-Workspace-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yuksalish Workspace"
    }
  }
}
