{
  "name": "yuksalish-workspace",
  "version": "0.17.3",
  "private": true,
  "description": "Yuksalish corporate workspace monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:desktop": "pnpm --filter @yuksalish/desktop dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.10.3",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
