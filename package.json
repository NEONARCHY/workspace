{
  "name": "yuksalish-workspace",
  "version": "0.30.3",
  "private": true,
  "description": "Yuksalish corporate workspace monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:desktop": "pnpm --filter @yuksalish/desktop dev",
    "dev:local": "node scripts/dev/local-workspace.mjs start --detach",
    "dev:local:stop": "node scripts/dev/local-workspace.mjs stop",
    "dev:local:status": "node scripts/dev/local-workspace.mjs status",
    "test:local-dev": "node --test scripts/dev/local-config.test.mjs",
    "check:local-dev": "node scripts/dev/smoke-local.mjs",
    "build:web": "pnpm --filter @yuksalish/desktop build:web",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:release-notes": "node scripts/validate-release-notes.mjs",
    "check:pr-overlaps": "node scripts/check-pr-overlaps.mjs --local",
    "test:workflow": "node --test scripts/lib/release-note-order.test.mjs scripts/lib/pr-overlap.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.10.3",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
