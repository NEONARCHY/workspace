POSTGRES_DB=yuksalish
POSTGRES_USER=yuksalish
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432
MINIO_ROOT_USER=yuksalish
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=workspace-files
YUKSALISH_ENVIRONMENT=development
YUKSALISH_DATABASE_URL=postgresql+asyncpg://yuksalish:change-me-local-only@postgres:5432/yuksalish
YUKSALISH_AUTH_SIGNING_KEY=change-me-local-auth-signing-key
YUKSALISH_AUTH_ENCRYPTION_KEY=change-me-local-auth-encryption-key
YUKSALISH_PASSWORD_RESET_TTL_HOURS=2
YUKSALISH_DEMO_PASSWORD=Yuksalish-Local-2026!
YUKSALISH_SEED_DEMO_DATA=true
YUKSALISH_REDIS_URL=redis://redis:6379/0
YUKSALISH_S3_ENDPOINT=minio:9000
YUKSALISH_S3_ACCESS_KEY=yuksalish
YUKSALISH_S3_SECRET_KEY=change-me-local-only
YUKSALISH_S3_SECURE=false
YUKSALISH_S3_BUCKET=workspace-files
YUKSALISH_MEMBERS_API_URL=
YUKSALISH_MEMBERS_INTEGRATION_KEY=change-me-members-integration-key
YUKSALISH_MEMBERS_CACHE_SECONDS=300
# Zoom Server-to-Server OAuth. Leave empty to keep the Zoom module switched off.
YUKSALISH_ZOOM_ACCOUNT_ID=
YUKSALISH_ZOOM_CLIENT_ID=
YUKSALISH_ZOOM_CLIENT_SECRET=
YUKSALISH_ZOOM_HOST_USER_ID=
YUKSALISH_ZOOM_TIMEZONE=Asia/Tashkent
YUKSALISH_ZOOM_REMINDER_MINUTES=30
YUKSALISH_ZOOM_BOOKING_HORIZON_DAYS=180
YUKSALISH_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace-with-reviewed-pinned-version
CLOUDFLARE_TUNNEL_TOKEN=
