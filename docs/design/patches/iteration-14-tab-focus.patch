+++ b/apps/desktop/src/renderer/workspace-tab-focus.css
@@ -0,0 +1,20 @@
+/* Visible focus is opted into by Tab/Shift+Tab. Keep DOM focus, caret,
+   validation, selected states and keyboard actions unchanged. This final
+   modality gate intentionally overrides legacy focus and Fluent rings. */
+html:not([data-workspace-tab-focus]) body .app-provider :is(
+  button, a, input, textarea, select, [tabindex], [role="button"],
+  [role="menuitem"], [role="tab"], .fui-Input, .fui-Textarea,
+  .fui-Checkbox, .fui-Radio, .fui-Switch, .workspace-select
+):is(:focus, :focus-visible, :focus-within) {
+  outline: none !important;
+  box-shadow: none !important;
+}
+html:not([data-workspace-tab-focus]) body .app-provider :is(
+  button, a, input, textarea, select, [tabindex], [role="button"],
+  [role="menuitem"], [role="tab"], .fui-Input, .fui-Textarea,
+  .fui-Checkbox, .fui-Radio, .fui-Switch, .workspace-select
+):is(:focus, :focus-visible, :focus-within)::after,
+html:not([data-workspace-tab-focus]) body .app-provider .fui-Checkbox__indicator::after {
+  outline: none !important;
+  box-shadow: none !important;
+}
