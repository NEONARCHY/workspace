# Template only. Copy to .env.staging and replace every replace-with value.
POSTGRES_DB=yuksalish_staging
POSTGRES_USER=yuksalish
POSTGRES_PASSWORD=replace-with-staging-database-password
MINIO_ROOT_USER=yuksalish_staging
MINIO_ROOT_PASSWORD=replace-with-staging-minio-root-password
MINIO_BUCKET=yuksalish-staging-files
YUKSALISH_ENVIRONMENT=staging
YUKSALISH_DATABASE_URL=postgresql+asyncpg://yuksalish:replace-with-url-safe-database-password@postgres:5432/yuksalish_staging
YUKSALISH_AUTH_SIGNING_KEY=replace-with-random-staging-auth-signing-key
YUKSALISH_AUTH_ENCRYPTION_KEY=replace-with-random-staging-auth-encryption-key
YUKSALISH_PASSWORD_RESET_TTL_HOURS=2
YUKSALISH_SEED_DEMO_DATA=false
YUKSALISH_REDIS_URL=redis://redis:6379/1
YUKSALISH_S3_ENDPOINT=minio:9000
YUKSALISH_S3_ACCESS_KEY=yuksalish_staging
YUKSALISH_S3_SECRET_KEY=replace-with-staging-s3-secret-key
YUKSALISH_S3_SECURE=false
YUKSALISH_S3_BUCKET=yuksalish-staging-files
YUKSALISH_CORS_ORIGINS=["https://staging.example.invalid"]
CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace-with-reviewed-pinned-version
CLOUDFLARE_TUNNEL_TOKEN=replace-with-staging-cloudflare-tunnel-token
